
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=customer_db
DB_USER=postgres
DB_PASSWORD=replace-with-local-admin-password
READER_DB_USER=guardian_reader
READER_DB_PASSWORD=replace-with-reader-password
GUARDIAN_ENV=development
GUARDIAN_AUTH_ENABLED=false
QUALITY_ADAPTER=postgresql
# QUALITY_DATABASE_URL=postgresql://reader:password@localhost:5432/demo_database
# QUALITY_ADMIN_DATABASE_URL=postgresql://admin:password@localhost:5432/demo_database
# QUALITY_CONFIG=C:/absolute/path/to/quality.json
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=gemma3:1b
# SHA256 hashes of independently generated bearer tokens:
GUARDIAN_READER_TOKEN_HASH=
GUARDIAN_OPERATOR_TOKEN_HASH=
GUARDIAN_ADMIN_TOKEN_HASH=
# Optional independent connector settings:
TARGET_DB_HOST=
TARGET_DB_PORT=
TARGET_DB_NAME=
TARGET_DB_USER=
TARGET_DB_PASSWORD=
HISTORY_SOURCE_DB_HOST=
HISTORY_SOURCE_DB_PORT=
HISTORY_SOURCE_DB_NAME=
HISTORY_SOURCE_DB_USER=
HISTORY_SOURCE_DB_PASSWORD=
